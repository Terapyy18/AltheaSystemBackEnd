<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Commande #{{ order.id }} confirmée</title>
</head>
<body style="margin:0;padding:0;background-color:#f3f4f6;font-family:Arial,Helvetica,sans-serif;color:#1f2937;">
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color:#f3f4f6;padding:24px 0;">
    <tr>
        <td align="center">
            <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="600" style="max-width:600px;background-color:#ffffff;border-radius:12px;overflow:hidden;border:1px solid #e5e7eb;">
                <tr>
                    <td style="background-color:#0d9488;padding:24px 32px;color:#ffffff;">
                        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
                            <tr>
                                <td style="font-size:20px;font-weight:bold;letter-spacing:0.5px;">Althea Systems</td>
                                <td align="right" style="font-size:13px;opacity:0.9;">Commande #{{ order.id }}</td>
                            </tr>
                        </table>
                    </td>
                </tr>

                <tr>
                    <td style="padding:32px;">
                        <h1 style="margin:0 0 8px 0;font-size:22px;color:#0d9488;">Merci pour votre commande{% if user.firstName %}, {{ user.firstName }}{% endif %} !</h1>
                        <p style="margin:0 0 24px 0;font-size:15px;line-height:1.5;color:#374151;">
                            Votre paiement a bien été reçu. Vous trouverez ci-dessous le récapitulatif de votre commande.
                        </p>

                        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="border-collapse:collapse;margin-bottom:24px;">
                            <thead>
                            <tr>
                                <th align="left" style="padding:10px 8px;border-bottom:2px solid #0d9488;font-size:13px;text-transform:uppercase;color:#0d9488;letter-spacing:0.5px;">Produit</th>
                                <th align="center" style="padding:10px 8px;border-bottom:2px solid #0d9488;font-size:13px;text-transform:uppercase;color:#0d9488;letter-spacing:0.5px;">Qté</th>
                                <th align="right" style="padding:10px 8px;border-bottom:2px solid #0d9488;font-size:13px;text-transform:uppercase;color:#0d9488;letter-spacing:0.5px;">PU</th>
                                <th align="right" style="padding:10px 8px;border-bottom:2px solid #0d9488;font-size:13px;text-transform:uppercase;color:#0d9488;letter-spacing:0.5px;">Total</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for item in items %}
                                <tr>
                                    <td style="padding:12px 8px;border-bottom:1px solid #e5e7eb;font-size:14px;color:#1f2937;">{{ item.title }}</td>
                                    <td align="center" style="padding:12px 8px;border-bottom:1px solid #e5e7eb;font-size:14px;color:#374151;">{{ item.quantity }}</td>
                                    <td align="right" style="padding:12px 8px;border-bottom:1px solid #e5e7eb;font-size:14px;color:#374151;">{{ item.unit_price|number_format(2, ',', ' ') }} €</td>
                                    <td align="right" style="padding:12px 8px;border-bottom:1px solid #e5e7eb;font-size:14px;color:#1f2937;font-weight:bold;">{{ item.line_total|number_format(2, ',', ' ') }} €</td>
                                </tr>
                            {% endfor %}
                            </tbody>
                            <tfoot>
                            <tr>
                                <td colspan="3" align="right" style="padding:14px 8px;font-size:15px;font-weight:bold;color:#1f2937;">Total commande</td>
                                <td align="right" style="padding:14px 8px;font-size:18px;font-weight:bold;color:#0d9488;">{{ totalAmount|number_format(2, ',', ' ') }} €</td>
                            </tr>
                            </tfoot>
                        </table>

                        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color:#f0f9ff;border:1px solid #bae6fd;border-radius:8px;margin-bottom:24px;">
                            <tr>
                                <td style="padding:16px 20px;">
                                    <p style="margin:0 0 6px 0;font-size:13px;font-weight:bold;text-transform:uppercase;color:#0369a1;letter-spacing:0.5px;">Adresse de livraison</p>
                                    {% if address %}
                                        <p style="margin:0;font-size:14px;line-height:1.5;color:#1f2937;">
                                            {% if user.firstName or user.lastName %}{{ user.firstName }} {{ user.lastName }}<br>{% endif %}
                                            {{ address.address }}<br>
                                            {{ address.postalCode }} {{ address.city }}<br>
                                            {{ address.countryCode|default('FR') }}
                                        </p>
                                    {% else %}
                                        <p style="margin:0;font-size:14px;color:#6b7280;">Adresse non spécifiée.</p>
                                    {% endif %}
                                </td>
                            </tr>
                        </table>

                        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin-bottom:24px;">
                            <tr>
                                <td style="font-size:13px;color:#6b7280;padding:4px 0;">
                                    <strong style="color:#374151;">Statut :</strong> {{ order.status }}
                                </td>
                            </tr>
                            {% if order.payedAt %}
                                <tr>
                                    <td style="font-size:13px;color:#6b7280;padding:4px 0;">
                                        <strong style="color:#374151;">Payée le :</strong> {{ order.payedAt|date('d/m/Y à H:i') }}
                                    </td>
                                </tr>
                            {% endif %}
                        </table>

                        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin-bottom:24px;">
                            <tr>
                                <td align="center">
                                    <a href="{{ orders_url }}"
                                       style="display:inline-block;background-color:#0d9488;color:#ffffff;text-decoration:none;padding:12px 28px;border-radius:9999px;font-size:15px;font-weight:bold;letter-spacing:0.3px;">
                                        Voir ma commande
                                    </a>
                                </td>
                            </tr>
                        </table>

                        <p style="margin:0;font-size:12px;color:#6b7280;line-height:1.5;">
                            Votre facture est disponible dans votre espace client.
                        </p>
                    </td>
                </tr>

                <tr>
                    <td style="background-color:#f9fafb;padding:16px 32px;text-align:center;font-size:11px;color:#9ca3af;border-top:1px solid #e5e7eb;">
                        © Althea Systems — Cet email vous est envoyé suite à une commande passée sur notre site.
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
</body>
</html>
